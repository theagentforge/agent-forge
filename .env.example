# Variable NAMES only. Never put real values in this file or anywhere in git.
# Real secrets live in Cloudflare (Worker → Settings → Variables and Secrets) and in Apple Passwords.
# For local development, copy apps/forge/.dev.vars.example to apps/forge/.dev.vars (git-ignored) and fill it in.

# GitHub OAuth app for "Sign in with GitHub" (one app per environment)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# HMAC key that signs stored reports (generated inside Cloudflare; nobody needs to see it)
REPORT_SIGNING_KEY=
# Signs website session cookies and CSRF tokens (generated inside Cloudflare)
SESSION_SECRET=
# Keys the buyer data room export's pseudonyms (ADR 0098; optional, SESSION_SECRET until set; generated inside Cloudflare)
EXPORT_PSEUDONYM_KEY=
